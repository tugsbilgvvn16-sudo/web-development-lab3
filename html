<!DOCTYPE html>
<html lang="mn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Лаборатори 03 - Загварчлагдсан форм</title>
  
  <!-- 5. Google Fonts (Inter фонт холбох) -->
   
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- 1. External CSS файлыг холбох -->
  <link rel="stylesheet" href="css/style.css">
</head>
<body>

  <!-- 2. Class сонгогч ашигласан Header -->
  <header class="page-header">
    <h1>Хэрэглэгчийн бүртгэлийн анкет</h1>
    <p>Лаборатори 03: CSS загварчлал ба байрлал</p>
  </header>

  <!-- Хуудасны үндсэн хэсэг -->
  <main class="page-main">
    <div class="form-container">
      
      <!-- 4. Position relative/absolute ашигласан жишээ (Badge) -->
      <div class="badge-wrapper">
        <span class="required-badge">Заавал бөглөх</span>
      </div>

      <form action="#" method="POST">
        
        <!-- Нэр input -->
        <div class="form-group">
          <label for="fullname" class="form-label">Овог нэр:</label>
          <input type="text" id="fullname" name="fullname" class="form-input" required placeholder="Доржийн Бат">
        </div>

        <!-- Имэйл input -->
        <div class="form-group">
          <label for="email" class="form-label">Имэйл хаяг:</label>
          <input type="email" id="email" name="email" class="form-input" required placeholder="example@mail.com">
        </div>

        <!-- Нууц үг input -->
        <div class="form-group">
          <label for="password" class="form-label">Нууц үг:</label>
          <input type="password" id="password" name="password" class="form-input" required pattern="(?=.*\d)(?=.*[a-zA-Z]).{8,}" title="Хамгийн багадаа 8 тэмдэгт, үсэг болон тоо агуулсан байх">
        </div>

        <!-- Огноо input -->
        <div class="form-group">
          <label for="dob" class="form-label">Төрсөн огноо:</label>
          <input type="date" id="dob" name="dob" class="form-input" required>
        </div>

        <!-- Хүйс (Radio) -->
        <fieldset class="form-fieldset">
          <legend class="form-legend">Хүйс:</legend>
          <div class="radio-group">
            <input type="radio" id="male" name="gender" value="male" required>
            <label for="male">Эрэгтэй</label>
            <input type="radio" id="female" name="gender" value="female">
            <label for="female">Эмэгтэй</label>
          </div>
        </fieldset>

        <!-- Сонирхол (Checkbox) -->
        <fieldset class="form-fieldset">
          <legend class="form-legend">Сонирхол:</legend>
          <div class="checkbox-group">
            <input type="checkbox" id="sports" name="interests" value="sports">
            <label for="sports">Спорт</label>
            <input type="checkbox" id="tech" name="interests" value="tech">
            <label for="tech">Технологи</label>
          </div>
        </fieldset>

        <!-- Боловсрол (Select) -->
        <div class="form-group">
          <label for="education" class="form-label">Боловсролын түвшин:</label>
          <select id="education" name="education" class="form-input" required>
            <option value="">-- Сонгоно уу --</option>
            <option value="bachelor">Бакалавр</option>
            <option value="master">Магистр</option>
          </select>
        </div>

        <!-- Товчлуур -->
        <button type="submit" class="submit-btn">Бүртгүүлэх</button>

      </form>
    </div>
  </main>

  <!-- Footer -->
  <footer class="page-footer">
    <p>&copy; 2026 Лаборатори 03. Бүх эрх хамгаалагдсан.</p>
  </footer>

</body>
</html>
